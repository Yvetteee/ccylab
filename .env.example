# Search-engine indexing control (server-side only — do NOT use NEXT_PUBLIC_).
#
# Controls the robots meta directive and /robots.txt:
#   - Preview / staging:                false (or unset)
#   - Production before official launch: false (or unset) — keeps the site
#                                         out of search results until ready
#   - Production after official launch:  true
#
# Changing this value requires a redeployment — it is read at build time.
SITE_INDEXABLE=false

# ---------------------------------------------------------------------------
# Application submission (build-time public configuration — no secrets here)
# ---------------------------------------------------------------------------

# Cloudflare Worker endpoint that receives application submissions.
# Leave empty to disable the online submission path (the email fallback
# remains available).
NEXT_PUBLIC_APPLICATION_API_URL=

# Cloudflare Turnstile site key (Managed mode). Leave empty to skip the
# widget locally; the Worker still verifies every token server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secondary email fallback recipient for the application form.
# TEST PHASE (approved): JZHANG193@e.ntu.edu.sg
# PRODUCTION RECIPIENT: NOT YET AUTHORIZED — changing it requires explicit
# human authorization.
NEXT_PUBLIC_APPLICATION_FALLBACK_EMAIL=JZHANG193@e.ntu.edu.sg
